# Production env for cdesk-mcp in remote OAuth (http) mode.
# Copy to .env.production and fill in. .env.production is gitignored — never commit it.
#
#   cp .env.production.example .env.production
#
# Note: CDESK_LOGIN / CDESK_PASSWORD are NOT used in http mode — each customer
# signs in with their own CDESK credentials on the consent page. Don't set them.

# ─── Transport ───────────────────────────────────────────────────────────
CDESK_TRANSPORT=http

# ─── CDESK tenant (default / fallback server) ────────────────────────────
# Tenant host only; the server appends /api/ internally. Used as the default
# when CDESK_BASE_URLS below is empty, and as the fallback for legacy sessions.
CDESK_BASE_URL=https://your-tenant.cdesk.example

# ─── CDESK servers offered on the login dropdown ─────────────────────────
# Comma-separated Label=URL pairs. The user picks which server their session
# targets on the login page; the choice is baked into their token. The FIRST
# entry is the pre-selected default. If unset, the single CDESK_BASE_URL above
# is the only option.
# CDESK_BASE_URLS=Production=https://cmpp.seal.sk,Test=https://test.seal.sk
#
# Allow a "Custom…" option where the user pastes their own server URL. Any
# scheme is accepted (incl. http://) and there is NO SSRF/allowlist check — the
# login page warns the user they own that choice. Set to 0/false to disable.
# CDESK_ALLOW_CUSTOM_BASE_URL=true

# ─── Public endpoint ─────────────────────────────────────────────────────
# The externally reachable HTTPS URL clients connect to — the OAuth issuer and
# browser redirect base. MUST match the domain your TLS proxy / Cloudflare
# serves. No trailing slash. (Customers add <this>/mcp as the connector URL.)
CDESK_PUBLIC_URL=https://mcp.your-domain.example

# ─── Session encryption key (sessions live inside the tokens) ────────────
# There is NO datastore: each OAuth session is Fernet-encrypted into the token
# Claude holds, and the server decrypts it on each request. This key is what
# makes that possible. Generate ONCE and keep it STABLE and SECRET:
#   * stable  → sessions survive restarts and span replicas (any process with
#     the key can decrypt the tokens); rotating it logs every customer out.
#   * secret  → it protects every customer's CDESK refresh token in transit.
# Prefer a secrets manager over this file. If unset, the server uses an
# ephemeral per-process key and every session is lost on restart.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CDESK_ENCRYPTION_KEY=

# ─── Bind (inside the container) ─────────────────────────────────────────
CDESK_HTTP_HOST=0.0.0.0
CDESK_HTTP_PORT=8000

# ─── Optional: extra DNS-rebinding allowlist entries (comma-separated) ────
# public_url, claude.ai, claude.com and the local bind are always allowed.
# Add more only if your proxy presents a different Host/Origin.
# CDESK_ALLOWED_HOSTS=mcp.your-domain.example
# CDESK_ALLOWED_ORIGINS=https://mcp.your-domain.example

# Set to 1 when behind a trusted proxy / Cloudflare so the login rate limiter
# uses the real client IP from CF-Connecting-IP / X-Forwarded-For (spoofable, so
# only trust them behind a proxy). Recommended in this compose/proxy setup.
# CDESK_TRUST_PROXY=1
#
# Note: http mode requires https:// CDESK_BASE_URL / CDESK_PUBLIC_URL (localhost
# exempt) — the server refuses to start on plaintext http://.

# ─── Optional ────────────────────────────────────────────────────────────
# CDESK_LOG_LEVEL=INFO
# CDESK_TIMEOUT_SECONDS=30
