# cdesk-mcp — environment configuration
#
# Copy this file to `.env` (one directory up from .ai/, alongside the
# project's pyproject.toml) and fill in the three required values below.
# `.env` is gitignored.
#
# ─────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────

# CDESK tenant base URL — just the host. The server appends /api/
# internally, so v3 endpoints reach <CDESK_BASE_URL>/api/v3/<resource>.
# Older configs that include a trailing /api still work (the client
# normalizes both forms). Example for the SealIT tenant:
CDESK_BASE_URL=https://cmpp.seal.sk

# Your CDESK username (or email). The server uses this once at startup
# to obtain an apitoken via POST /api/auth/login. If the value contains
# '@', CDESK auto-detects an LDAP connector from the email's domain.
CDESK_LOGIN=

# Your CDESK password. The server caches the resulting apitoken in
# memory only — your password is never written to disk or to logs.
#
# Account constraints:
#   - 2FA-enabled accounts are NOT supported in this auth flow. Use an
#     account without 2FA, or obtain an apitoken some other way.
#   - The account needs ACL access to whichever CDESK modules you plan
#     to use (Tasks / Customers / Users) AND the corresponding modules
#     must be enabled in the tenant's global settings (e.g.
#     Administration → Global Settings → Tasks → Enabled).
CDESK_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────

# HTTP timeout per CDESK request, in seconds. Default: 30.
# CDESK_TIMEOUT_SECONDS=30

# Log level for cdesk-mcp's own logger. DEBUG / INFO / WARNING / ERROR
# / CRITICAL. Default: INFO. Logs always go to stderr (stdout is
# reserved for the MCP JSON-RPC stream and must stay clean).
# CDESK_LOG_LEVEL=INFO

# Tenant timezone (IANA name). Datetimes WITHOUT an explicit offset
# (e.g. "2026-06-05T08:00:00" for a task's valid_from) are interpreted as
# wall-clock time in THIS zone and sent to CDESK with the proper offset —
# CDESK would otherwise read them as UTC and the UI would show them
# shifted (the live tenant displays times in its own timezone).
# Default: Europe/Bratislava.
# CDESK_TIMEZONE=Europe/Bratislava

# Grounded-answer evidence threshold. The minimum number of distinct
# records that must support a theme before verify_claims will
# confirm it as a *pattern* (e.g. "phones need fixing"). 1..threshold-1
# are reported as isolated mentions, not needs. Applies ONLY to
# pattern-kind claims — specific look-ups and existence checks ignore it.
# Overridable per call. Default: 3.
# CDESK_EVIDENCE_THRESHOLD=3

# ─────────────────────────────────────────────────────────────────────
# REMOTE / MULTI-USER (OAuth over HTTPS)
# ─────────────────────────────────────────────────────────────────────
# Transport. "stdio" (default) = local single-user; the CDESK_LOGIN /
# CDESK_PASSWORD above are used. "http" = remote Streamable-HTTP server
# that acts as its own OAuth 2.1 authorization server: each user signs in
# with THEIR OWN CDESK login at a consent page, so CDESK_LOGIN /
# CDESK_PASSWORD are NOT used (only CDESK_BASE_URL + CDESK_PUBLIC_URL).
# CDESK_TRANSPORT=stdio

# Required in http mode. The externally reachable HTTPS base URL clients
# connect to — used as the OAuth issuer and the browser redirect target.
# For local testing, expose the port below via ngrok and put that URL here
# (or http://127.0.0.1:8000 for Inspector-only local testing).
# CDESK_PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Path the MCP endpoint is served on (http mode). Default "/mcp", so clients
# connect to <CDESK_PUBLIC_URL>/mcp. Set it to "/" (or empty) for ROOT hosting,
# where the bare CDESK_PUBLIC_URL is the address clients paste — useful when the
# server owns its own hostname (https://mcp.example.com). Leading/trailing
# slashes are optional: "mcp", "/mcp" and "/mcp/" are the same endpoint.
# Changing this changes the OAuth token audience with it, so every existing
# client must be re-pointed at the new address.
# CDESK_MCP_PATH=/mcp

# http-mode bind address + port (the endpoint is <host>:<port><CDESK_MCP_PATH>).
# CDESK_HTTP_HOST=127.0.0.1
# CDESK_HTTP_PORT=8000

# CDESK servers offered on the login dropdown (http mode). Comma-separated
# Label=URL pairs; the user picks one at login and the choice is baked into
# their token. FIRST entry = pre-selected default. Unset → only CDESK_BASE_URL.
# CDESK_BASE_URLS=Production=https://cmpp.seal.sk,Test=https://test.seal.sk
# Allow a "Custom…" option (user pastes their own URL; any scheme, NO SSRF
# check — the page warns them). Set 0/false to disable.
# CDESK_ALLOW_CUSTOM_BASE_URL=true

# "Sign in with Microsoft" (Office365 SSO, http mode). ON BY DEFAULT — set this
# to false only to force password-only sign-in. The login page shows a Microsoft
# button that 302s the browser into the chosen CDESK server's Azure SSO
# (/api/auth/azure/redirect); CDESK returns the apitoken + refresh token directly
# to the callback. The MCP server never touches Microsoft directly and needs NO
# client_id/client_secret and NO connector id — the per-server Azure connector id
# is discovered at runtime from the public /api/auth/connector list, so one
# connector serves every CDESK server the user selects. The button is only shown
# once the user's server has been verified AND reported an azure connector, so
# leaving this on costs nothing for tenants that don't use Entra.
# CDESK_AZURE_LOGIN_ENABLED=true

# Session encryption key (http mode). There is no datastore — each OAuth
# session (clients, codes, access/refresh tokens, and the per-user CDESK
# credential) is Fernet-encrypted INTO the token the client holds, and the
# server decrypts it per request. Set a STABLE key so sessions survive restarts
# and span replicas (rotating it logs everyone out); if unset, an ephemeral
# per-process key is used and sessions are lost on restart (fine for quick local
# testing). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CDESK_ENCRYPTION_KEY=

# Extra entries appended to the DNS-rebinding allowlists (comma-separated).
# public_url, the local bind, claude.ai and claude.com are always allowed; add
# more only if you front the server with a proxy whose Host/Origin differs or
# you need to permit additional client origins.
# CDESK_ALLOWED_HOSTS=mcp.example.com
# CDESK_ALLOWED_ORIGINS=https://mcp.example.com

# Set to 1/true ONLY when behind a trusted reverse proxy / Cloudflare. Then the
# login rate limiter trusts CF-Connecting-IP / X-Forwarded-For for the real
# client IP; otherwise those headers are spoofable and the socket peer is used.
# CDESK_TRUST_PROXY=1

# In http mode, CDESK_BASE_URL and CDESK_PUBLIC_URL must be https:// (localhost
# is exempt for local testing) — the server refuses to start otherwise, so
# credentials/tokens never traverse the network in cleartext.
